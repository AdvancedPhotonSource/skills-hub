{
	"name": "aps-skills-hub",
	"version": "0.1.0",
	"private": true,
	"overrides": {
		"cookie": "^0.7.2"
	},
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"start": "node build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"seed": "tsx scripts/import-catalog.ts --local-only",
		"curate": "tsx scripts/curate.ts",
		"import:catalog": "tsx scripts/import-catalog.ts",
		"admin": "tsx scripts/admin.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.0.3",
		"fflate": "^0.8.3",
		"@lucide/svelte": "^1.61.0",
		"marked": "^18.1.1",
		"sanitize-html": "^2.18.1",
		"yaml": "^2.8.0",
		"yauzl": "^3.4.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.62.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.0.0",
		"@types/sanitize-html": "^2.16.0",
		"@types/yauzl": "^2.10.3",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tsx": "^4.20.0",
		"typescript": "^6.0.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
