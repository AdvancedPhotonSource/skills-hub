[Unit]
Description=APS Skills Hub
After=network.target

[Service]
Type=simple
WorkingDirectory=/local/haskels/skills-hub/current
ExecStart=/local/haskels/skills-hub/runtime/node/bin/node build/index.js
Environment=NODE_ENV=production
Environment=ORIGIN=https://arecibo.xray.aps.anl.gov:9005
Environment=HOST=127.0.0.1
Environment=PORT=19005
Environment=DATA_DIR=/local/haskels/skills-hub/data
Environment=BODY_SIZE_LIMIT=12M
Environment=ADDRESS_HEADER=x-forwarded-for
Environment=XFF_DEPTH=1
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true

[Install]
WantedBy=default.target
