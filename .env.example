DATA_DIR=./data
# Optional server-side token for higher public GitHub API limits:
# GITHUB_TOKEN=
# Production: set the externally visible origin (without a path).
# ORIGIN=https://kairo.aps.anl.gov:8443
# BASE_PATH=/skills-hub
# HOST=127.0.0.1
# PORT=3000
# BODY_SIZE_LIMIT=12M

# Entra OIDC: required for all site access. Missing credentials do not enable public/local access.
# Keep the secret server-side; use the secret VALUE, not its ID.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=0cfca185-25f7-49e3-8ae7-704d5326e285
# ENTRA_REDIRECT_URI=https://kairo.aps.anl.gov:8443/auth/callback/entra
